# ---------------------------------------------------------------------------
# Knowledge Navigator — personal configuration
#
# Copy to .env and edit. .env is ignored by Git and excluded from image build
# contexts. Put no credentials here: this service has no accounts and talks to
# nothing that authenticates.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- where the service listens ---------------------------------------------
# Loopback only. Change this only if you intend the service to be reachable
# from another machine — it has no authentication of any kind.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# --- assistant -------------------------------------------------------------
# ollama    talk to a local Ollama (the default).
# disabled  no generation at all. Browsing, search and the graph still work,
#           and /api/assistant/status says plainly that it is switched off.
#           Choose this deliberately when no model should ever be contacted.
# fixture   deterministic test double. Refused when NODE_ENV=production.
ASSISTANT_PROVIDER=ollama

# The personal stack uses Ollama installed natively on the host, so the model
# gets Apple acceleration while the application stays containerized.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.8:27b-mlx

# For a machine with no native Ollama, do not edit the two lines above. Run the
# portable fallback instead, which starts Ollama inside Compose and pulls a
# smaller model into the ollama-data volume:
#
#   OLLAMA_BASE_URL=http://ollama:11434 OLLAMA_MODEL=qwen3:8b \
#     docker compose --profile container-ollama up --build -d

# How long to wait for a local model before giving up. A large model on a cold
# start can take a while; the browser shows a waiting state and can cancel.
ASSISTANT_TIMEOUT_MS=120000

# Maximum characters of canonical material placed in a model prompt.
ASSISTANT_CHARACTER_BUDGET=14000

# --- storage ---------------------------------------------------------------
# Inside the containers. The compiled index lives in the navigator-data volume
# and is rebuilt from canonical Markdown on every start, so it is disposable.
DATABASE_PATH=/data/knowledge.db
CONTENT_PATH=/app/content/concepts

# --- service ---------------------------------------------------------------
PORT=8000
LOG_LEVEL=info

# Origins allowed to call the API directly from a browser. The web container
# proxies /api on the same origin, so this matters only for direct access.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

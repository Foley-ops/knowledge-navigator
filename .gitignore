# ---------------------------------------------------------------------------
# Knowledge Navigator — Git ignore boundary
#
# Canonical knowledge lives in content/concepts/*.md and IS tracked.
# Everything derived from it (SQLite, build output, caches) is disposable
# and is NOT tracked. See the runbook, section 4.2.
#
# Deliberately NOT ignored: .env.example, generated/graph.json,
# apps/web/sidebars.generated.ts, package-lock.json.
# ---------------------------------------------------------------------------

# Secrets and local configuration
.env
.env.*
!.env.example

# Dependencies
node_modules/
.npm/
.pnpm-store/

# Build output.
# Patterns are anchored: a bare `lib/` or `build/` also matches source
# directories such as apps/web/src/lib, which silently drops real source from
# the repository and from image build contexts.
dist/
/build/
apps/web/build/
out/
*.tsbuildinfo
apps/web/.docusaurus/
apps/web/build/
.docusaurus/

# Test and coverage artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/
playwright/.cache/

# Compiled index — rebuildable from canonical Markdown at any time
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.tmp
data/*.db.tmp*
*.sqlite
*.sqlite3
knowledge.db
knowledge.db-*

# Logs
*.log
logs/
npm-debug.log*
yarn-error.log*

# Local model data (host Ollama is managed outside this project)
.ollama/
ollama/
ollama-data/
*.gguf
*.safetensors

# Operating-system and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Version 2 — private local work area.
#
# Canonical v2 content IS tracked: content/atlas.yaml and content/graph-only/.
# Everything below is personal, machine-local, or an unreviewed agent proposal,
# and must never enter Git. See the v2 runbook, checkpoint J03 and section 3.
# ---------------------------------------------------------------------------

# Proposal workspaces, private exports, and agent scratch space
.navigator/

# Private personal database (never rebuildable from canonical Markdown)
data/personal.db
data/personal.db-*
personal.db
personal.db-*

# Uploaded originals and extraction temporaries.
# Original bytes are never retained, but a streaming upload may touch disk.
data/uploads/
data/artifacts/
data/extraction/
*.upload.tmp
*.extract.tmp

# Private exports written outside .navigator/exports by --allow-external-output
exports/
*.navigator-export.json

{
  "name": "@navigator/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Canonical-content schema, loader, validator, compiler, query layer and CLI for the Knowledge Navigator.",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "navigator": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "tsc --build --clean tsconfig.json",
    "typecheck": "tsc --build --force tsconfig.json && tsc --project tsconfig.spec.json"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mdast": "4.0.4"
  }
}

{
  "$id": "https://knowledge-navigator.local/schemas/proposal.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from packages/core/src/proposal.ts — do not edit by hand. A proposal is a local, reviewable bundle of agent work that has not touched canonical knowledge. JSON Schema cannot express the rules that matter most here: every allowed path must be a file under content/concepts/ or content/graph-only/ with no absolute path, no parent traversal, no backslash and no control character; a Tier 2 proposal may write only Markdown and a Tier 3 proposal only YAML; a rejection reason may appear only on a rejected proposal; the base commit must be present in this repository; and status may only move as PROPOSAL_TRANSITIONS allows. Those are enforced by `navigator proposal validate`, which is authoritative.",
  "properties": {
    "agent": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "taskId": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "allowedPaths": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "baseCommit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "createdAt": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
    },
    "proposalId": {
      "maxLength": 120,
      "minLength": 8,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "rejectedReason": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    },
    "requestedTier": {
      "anyOf": [
        {
          "const": 2,
          "type": "number"
        },
        {
          "const": 3,
          "type": "number"
        }
      ]
    },
    "status": {
      "enum": [
        "prepared",
        "running",
        "review",
        "accepted",
        "rejected",
        "superseded"
      ],
      "type": "string"
    },
    "targetBacklogId": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "proposalId",
    "targetBacklogId",
    "requestedTier",
    "allowedPaths",
    "baseCommit",
    "createdAt",
    "status"
  ],
  "title": "Knowledge Navigator proposal manifest",
  "type": "object"
}
